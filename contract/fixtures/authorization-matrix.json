{
  "version": "0.2.0",
  "description": "Matriz de autorización del contrato (fuente única; la consumen la prueba de reflexión de la API, Vitest, check_contract.py y el E2E). Cada fila de 'rows' es una operación de api.v1.yaml: 'path' es la ruta OpenAPI exacta; 'minimum' es el rol mínimo (viewer < annotator < project-admin dentro del proyecto; global-admin; any-authenticated; anonymous); 'permission' es el permiso de proyecto que se exige (null si no aplica); 'scope' es el recurso del que se deduce el proyecto; 'nonMember' es la respuesta que recibe un usuario sin membresía (404 oculta el recurso, 403 lo deniega, null si la operación no tiene ámbito de proyecto). 'ownerOnly' indica que, además del rol, solo el autor puede ejecutar la operación (ADR-07, también el administrador global). El administrador global tiene rol efectivo project-admin en todos los proyectos.",
  "roles": {
    "global": ["admin", "user"],
    "project": ["viewer", "annotator", "project-admin"]
  },
  "permissions": {
    "project.view": "viewer",
    "annotation.write": "annotator",
    "catalog.manage": "project-admin",
    "image.upload": "project-admin",
    "member.manage": "project-admin",
    "dataset.export": "project-admin"
  },
  "rows": [
    {"method": "POST", "path": "/api/v1/auth/login", "minimum": "anonymous", "permission": null, "scope": "none", "nonMember": null},
    {"method": "POST", "path": "/api/v1/auth/logout", "minimum": "any-authenticated", "permission": null, "scope": "none", "nonMember": null},
    {"method": "GET", "path": "/api/v1/auth/me", "minimum": "any-authenticated", "permission": null, "scope": "none", "nonMember": null},
    {"method": "GET", "path": "/api/v1/users", "minimum": "global-admin", "permission": null, "scope": "none", "nonMember": null},
    {"method": "POST", "path": "/api/v1/users", "minimum": "global-admin", "permission": null, "scope": "none", "nonMember": null},
    {"method": "GET", "path": "/api/v1/users/{userId}", "minimum": "global-admin", "permission": null, "scope": "none", "nonMember": null},
    {"method": "PATCH", "path": "/api/v1/users/{userId}", "minimum": "global-admin", "permission": null, "scope": "none", "nonMember": null},
    {"method": "GET", "path": "/api/v1/projects", "minimum": "any-authenticated", "permission": null, "scope": "none", "nonMember": null},
    {"method": "POST", "path": "/api/v1/projects", "minimum": "global-admin", "permission": null, "scope": "none", "nonMember": null},
    {"method": "GET", "path": "/api/v1/projects/{projectId}", "minimum": "viewer", "permission": "project.view", "scope": "project", "nonMember": 404},
    {"method": "PATCH", "path": "/api/v1/projects/{projectId}", "minimum": "global-admin", "permission": null, "scope": "project", "nonMember": 403},
    {"method": "DELETE", "path": "/api/v1/projects/{projectId}", "minimum": "global-admin", "permission": null, "scope": "project", "nonMember": 403},
    {"method": "GET", "path": "/api/v1/projects/{projectId}/members", "minimum": "project-admin", "permission": "member.manage", "scope": "project", "nonMember": 404},
    {"method": "POST", "path": "/api/v1/projects/{projectId}/members", "minimum": "project-admin", "permission": "member.manage", "scope": "project", "nonMember": 404},
    {"method": "PATCH", "path": "/api/v1/projects/{projectId}/members/{userId}", "minimum": "project-admin", "permission": "member.manage", "scope": "project", "nonMember": 404},
    {"method": "DELETE", "path": "/api/v1/projects/{projectId}/members/{userId}", "minimum": "project-admin", "permission": "member.manage", "scope": "project", "nonMember": 404},
    {"method": "GET", "path": "/api/v1/projects/{projectId}/datasets", "minimum": "viewer", "permission": "project.view", "scope": "project", "nonMember": 404},
    {"method": "POST", "path": "/api/v1/projects/{projectId}/datasets", "minimum": "project-admin", "permission": "catalog.manage", "scope": "project", "nonMember": 404},
    {"method": "GET", "path": "/api/v1/datasets/{datasetId}", "minimum": "viewer", "permission": "project.view", "scope": "dataset", "nonMember": 404},
    {"method": "PATCH", "path": "/api/v1/datasets/{datasetId}", "minimum": "project-admin", "permission": "catalog.manage", "scope": "dataset", "nonMember": 404},
    {"method": "DELETE", "path": "/api/v1/datasets/{datasetId}", "minimum": "project-admin", "permission": "catalog.manage", "scope": "dataset", "nonMember": 404},
    {"method": "GET", "path": "/api/v1/datasets/{datasetId}/classes", "minimum": "viewer", "permission": "project.view", "scope": "dataset", "nonMember": 404},
    {"method": "POST", "path": "/api/v1/datasets/{datasetId}/classes", "minimum": "project-admin", "permission": "catalog.manage", "scope": "dataset", "nonMember": 404},
    {"method": "PATCH", "path": "/api/v1/classes/{classId}", "minimum": "project-admin", "permission": "catalog.manage", "scope": "class", "nonMember": 404},
    {"method": "DELETE", "path": "/api/v1/classes/{classId}", "minimum": "project-admin", "permission": "catalog.manage", "scope": "class", "nonMember": 404},
    {"method": "GET", "path": "/api/v1/storage/files", "minimum": "global-admin", "permission": null, "scope": "none", "nonMember": null},
    {"method": "GET", "path": "/api/v1/datasets/{datasetId}/images", "minimum": "viewer", "permission": "project.view", "scope": "dataset", "nonMember": 404},
    {"method": "POST", "path": "/api/v1/datasets/{datasetId}/images", "minimum": "global-admin", "permission": null, "scope": "dataset", "nonMember": 403},
    {"method": "POST", "path": "/api/v1/datasets/{datasetId}/images/upload", "minimum": "project-admin", "permission": "image.upload", "scope": "dataset", "nonMember": 404},
    {"method": "GET", "path": "/api/v1/images/{imageId}", "minimum": "viewer", "permission": "project.view", "scope": "image", "nonMember": 404},
    {"method": "GET", "path": "/api/v1/images/{imageId}/annotations", "minimum": "viewer", "permission": "project.view", "scope": "image", "nonMember": 404},
    {"method": "POST", "path": "/api/v1/images/{imageId}/annotations", "minimum": "annotator", "permission": "annotation.write", "scope": "image", "nonMember": 404},
    {"method": "GET", "path": "/api/v1/annotations/{annotationId}", "minimum": "viewer", "permission": "project.view", "scope": "annotation", "nonMember": 404},
    {"method": "PATCH", "path": "/api/v1/annotations/{annotationId}", "minimum": "annotator", "permission": "annotation.write", "scope": "annotation", "nonMember": 404, "ownerOnly": true},
    {"method": "DELETE", "path": "/api/v1/annotations/{annotationId}", "minimum": "annotator", "permission": "annotation.write", "scope": "annotation", "nonMember": 404, "ownerOnly": true},
    {"method": "POST", "path": "/api/v1/datasets/{datasetId}/imports", "minimum": "global-admin", "permission": null, "scope": "dataset", "nonMember": 403},
    {"method": "GET", "path": "/api/v1/datasets/{datasetId}/export", "minimum": "project-admin", "permission": "dataset.export", "scope": "dataset", "nonMember": 404},
    {"method": "GET", "path": "/internal/v1/tile-access", "minimum": "viewer", "permission": "project.view", "scope": "image", "nonMember": 403},
    {"method": "GET", "path": "/health/live", "minimum": "anonymous", "permission": null, "scope": "none", "nonMember": null},
    {"method": "GET", "path": "/health/ready", "minimum": "anonymous", "permission": null, "scope": "none", "nonMember": null}
  ]
}
