# Configuración del entorno (ADR-11, ADR-12, arquitectura §7.1, §8.8)

# Puertos
HTTP_PORT=8080
API_PORT=8080
DB_PORT=5432

# Modo de ejecución de ASP.NET Core y cookies
ASPNETCORE_ENVIRONMENT=Development
COOKIE_SECURE=false

# Base de datos PostgreSQL (PostgreSQL 18 estándar - ADR-07)
POSTGRES_DB=gia_db
POSTGRES_USER=gia_user
POSTGRES_PASSWORD=gia_dev_password_change_me

# Cadena de conexión para la API
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=gia_db;Username=gia_user;Password=gia_dev_password_change_me;

# Claves de Data Protection (sesión gia_session persistida - ADR-04)
DATA_PROTECTION_KEYS_PATH=/keys

# Administrador inicial (ADR-04, §7.1)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=gia_admin_password_change_me

# Directorio de imágenes en el host
IMAGES_DIR=./data/images
